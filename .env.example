# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env.local y completa con tus credenciales reales.
# REGLA: Nunca subas ni compartas .env.local con datos reales.
# ==============================================================================

# URL y clave anónima pública de tu proyecto Supabase (seguras para el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave secreta con rol de servicio (SOLO servidor - jamás exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# URL base del sitio web (desarrollo o producción)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto opcional para firma HMAC de visitantes (usa SUPABASE_ANON_KEY por defecto si no se define)
METRICS_HMAC_SECRET=clave-secreta-aleatoria-para-metricas

# Clave API para consulta automática de tasa BCV (solo servidor - CotizaVE)
COTIZAVE_API_KEY=

# Secreto de autorización para Vercel Cron (solo servidor - Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
